{
  "name": "dnd-luxury-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "D&D Luxury Marketplace — South Africa's authenticated luxury goods marketplace",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo-listings.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=setup --project=public --project=mobile --project=a11y --project=admin --project=seller --project=buyer && playwright test --project=flows",
    "test:e2e:assert": "playwright test --project=setup --project=public --project=mobile --project=a11y --project=admin --project=seller --project=buyer",
    "test:e2e:flows": "playwright test --project=flows"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
