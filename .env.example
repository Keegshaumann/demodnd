# ---------------------------------------------------------------------------
# D&D Luxury Marketplace — environment variables
# Copy this file to `.env.local` and fill in real values. Validated at startup
# by lib/env.ts (server) and lib/env.public.ts (client) using Zod.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and keys from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (STANDARD account — NOT Connect) --------------------------------
# D&D Luxury collects funds directly. No Connect, no escrow, no payouts.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret from: Stripe dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "D&D Luxury <no-reply@dndluxury.co.za>"
EMAIL_FROM=D&D Luxury <no-reply@dndluxury.co.za>
# Where new-submission alerts go (D&D admin inbox)
ADMIN_NOTIFICATION_EMAIL=admin@dndluxury.co.za

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
