# ---------------------------------------------------------------------------
# D&D Luxury Marketplace — environment variables
# Copy this file to `.env.local` and fill in real values. Validated at startup
# by lib/env.ts (server) and lib/env.public.ts (client) using Zod.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project URL and keys from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PayFast (South African gateway — hosted redirect flow) -----------------
# D&D Luxury collects funds directly. PayFast supports sole proprietors.
# Leave unset to use the public sandbox (env.ts defaults to merchant 10000100).
# For production: set PAYFAST_MODE=live and the real merchant credentials from
# the PayFast dashboard → Settings → Integration.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Passphrase set in the PayFast dashboard (Settings → Integration). Required for
# live; optional for sandbox but must match if configured there.
PAYFAST_PASSPHRASE=

# --- Resend (transactional email) -------------------------------------------
RESEND_API_KEY=re_xxx
# Verified sender, e.g. "D&D Luxury <no-reply@dndluxury.co.za>"
EMAIL_FROM=D&D Luxury <no-reply@dndluxury.co.za>
# Where new-submission alerts go (D&D admin inbox)
ADMIN_NOTIFICATION_EMAIL=admin@dndluxury.co.za

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
